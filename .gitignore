# Data: never commit the large DMA dumps.
# These are deliberately anchored rather than bare globs. A plain *.csv also matches the
# DIRECTORY src/AisPipeline.Adapters.Csv, because git sets core.ignorecase=true on macOS --
# which silently excluded that whole project until CI failed on a fresh clone.
data/
/*.csv
/*.zip

# .NET
bin/
obj/
*.user
[Dd]ebug/
[Rr]elease/
TestResults/
*.db
*.db-shm
*.db-wal

# OS / editor
.DS_Store
.vs/
.idea/

# Planning notes kept local: they reference context that does not belong in a public repo
ais-pipeline-plan_1.md

# Reference documents that are not ours to redistribute. This repo is public; BIMCO's forms are
# BIMCO's. docs/reference/sof/README.md carries the citation instead.
docs/reference/**/*.pdf
